# multiagentz — API key configuration
# Copy this file to .env and fill in the keys for providers you use.
# You only need ONE provider to get started.

# ── Anthropic (Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenAI ──────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=o4-mini

# ── xAI (Grok) ─────────────────────────────────────────
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-non-reasoning

# ── Google (Gemini) ─────────────────────────────────────
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# ── Mistral ─────────────────────────────────────────────
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# ── Cohere ──────────────────────────────────────────────
# COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025

# ── NVIDIA NIM ──────────────────────────────────────────
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ── Ollama (local) ──────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# ── Global override (any provider) ──────────────────────
# MAZ_LLM_MODEL=claude-sonnet-4-20250514
